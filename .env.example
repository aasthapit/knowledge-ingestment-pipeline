# ── Embedding Model ──────────────────────────────────────────────────────────
# Provider: openai | azure | sentence-transformers
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Dimensions produced by text-embedding-3-small = 1536
# Dimensions produced by text-embedding-3-large = 3072
EMBEDDING_DIMENSIONS=1536

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Azure OpenAI (only needed when EMBEDDING_PROVIDER=azure) ─────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Format: redis://[[username]:[password]]@host:port
# Redis Stack (RediSearch + RedisJSON) required — run locally with:
#   docker run -p 6379:6379 redis/redis-stack-server:latest
REDIS_URL=redis://localhost:6379
REDIS_INDEX_NAME=knowledge_index
REDIS_KEY_PREFIX=doc:

# ── Pipeline Settings ─────────────────────────────────────────────────────────
# Maximum characters per chunk (legacy Markdown pipeline)
CHUNK_MAX_CHARS=2000
# Overlap in characters between consecutive chunks within the same section
CHUNK_OVERLAP_CHARS=200
# Batch size for embedding API calls
EMBED_BATCH_SIZE=32

# ── JSONL Export ──────────────────────────────────────────────────────────────
JSONL_OUTPUT_DIR=./output

# ── Quality Gate ──────────────────────────────────────────────────────────────
# Documents scoring below this threshold are flagged for human review.
# 0.0 = flag everything  |  1.0 = auto-approve everything
QUALITY_THRESHOLD=0.6

# ── Vector Backend ────────────────────────────────────────────────────────────
# "redis"  — uses the RediSearch FLAT vector index (good for dev / small-medium scale)
# "qdrant" — uses Qdrant HNSW index (recommended for production at scale)
VECTOR_BACKEND=redis

# ── Qdrant (only needed when VECTOR_BACKEND=qdrant) ──────────────────────────
# Run locally:  docker run -p 6333:6333 -p 6334:6334 qdrant/qdrant
# Cloud:        https://cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# ── Docling Chunker ───────────────────────────────────────────────────────────
# Maximum tokens per chunk when using Docling HybridChunker.
# 512 tokens ≈ 400 words — good balance for retrieval accuracy.
DOCLING_MAX_TOKENS=512

# ── Confluence ────────────────────────────────────────────────────────────────
# Pre-fill the Confluence import page so you don't have to re-enter credentials.
# All values can still be overridden in the UI.
CONFLUENCE_BASE_URL=https://confluence.mycompany.com
# cloud | server  (server = PAT; cloud = email + API token)
CONFLUENCE_AUTH_TYPE=server
# Cloud only — leave empty for Server/DC
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# Set to false for instances with self-signed / internal CA certificates
CONFLUENCE_VERIFY_SSL=true

# ── MongoDB (staging store + KB ledger) ───────────────────────────────────────
# The app builds the connection URI from the individual fields below.
# If you prefer to supply a full URI (e.g. from a secrets manager that returns
# a connection string), set MONGODB_URI and the other fields are ignored.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/knowledge_pipeline

# Hostname only — no scheme, no port.
# Atlas example:   cluster0.abc12.mongodb.net
# Local example:   localhost
MONGODB_HOST=localhost

# Username and password — injected from Vault or set directly here.
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Use mongodb+srv:// (DNS SRV discovery). Required for Atlas and most cloud
# hosts. Set to false for a plain host:port connection (e.g. local dev).
MONGODB_SRV=true

# Only used when MONGODB_SRV=false.
MONGODB_PORT=27017

# Authentication database. Use "$external" for LDAP / X.509 / AWS IAM auth.
# Leave empty to default to MONGODB_DB_NAME.
MONGODB_AUTH_SOURCE=
# Auth mechanism — leave empty for auto-negotiation (usually fine).
# Set explicitly if the server rejects the negotiated mechanism.
# Options: SCRAM-SHA-256, SCRAM-SHA-1, PLAIN, GSSAPI
MONGODB_AUTH_MECHANISM=

# Set to false to disable TLS. Ignored when MONGODB_SRV=true (SRV always uses TLS).
MONGODB_TLS=true
# Set to true to skip TLS certificate verification.
# Use this when the server has a self-signed or internally-signed certificate.
MONGODB_TLS_INSECURE=false

# All collections are created inside this database automatically.
MONGODB_DB_NAME=knowledge_pipeline

# Optional prefix applied to every collection name (e.g. "prod_" or "dev_").
# Useful when sharing one MongoDB instance across environments.
MONGODB_COLLECTION_PREFIX=
