# ── Embedding Model ──────────────────────────────────────────────────────────
# Provider: openai | azure | sentence-transformers
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Dimensions produced by text-embedding-3-small = 1536
# Dimensions produced by text-embedding-3-large = 3072
EMBEDDING_DIMENSIONS=1536

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Azure OpenAI (only needed when EMBEDDING_PROVIDER=azure) ─────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Format: redis://[[username]:[password]]@host:port
# Redis Stack (RediSearch + RedisJSON) required — run locally with:
#   docker run -p 6379:6379 redis/redis-stack-server:latest
REDIS_URL=redis://localhost:6379
REDIS_INDEX_NAME=knowledge_index
REDIS_KEY_PREFIX=doc:

# ── Pipeline Settings ─────────────────────────────────────────────────────────
# Maximum characters per chunk (legacy Markdown pipeline)
CHUNK_MAX_CHARS=2000
# Overlap in characters between consecutive chunks within the same section
CHUNK_OVERLAP_CHARS=200
# Batch size for embedding API calls
EMBED_BATCH_SIZE=32

# ── JSONL Export ──────────────────────────────────────────────────────────────
JSONL_OUTPUT_DIR=./output

# ── Quality Gate ──────────────────────────────────────────────────────────────
# Documents scoring below this threshold are flagged for human review.
# 0.0 = flag everything  |  1.0 = auto-approve everything
QUALITY_THRESHOLD=0.6

# ── Vector Backend ────────────────────────────────────────────────────────────
# "redis"  — uses the RediSearch FLAT vector index (good for dev / small-medium scale)
# "qdrant" — uses Qdrant HNSW index (recommended for production at scale)
VECTOR_BACKEND=redis

# ── Qdrant (only needed when VECTOR_BACKEND=qdrant) ──────────────────────────
# Run locally:  docker run -p 6333:6333 -p 6334:6334 qdrant/qdrant
# Cloud:        https://cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# ── Docling Chunker ───────────────────────────────────────────────────────────
# Maximum tokens per chunk when using Docling HybridChunker.
# 512 tokens ≈ 400 words — good balance for retrieval accuracy.
DOCLING_MAX_TOKENS=512

# ── MongoDB (staging store + KB ledger) ───────────────────────────────────────
# Used for the document review queue and the permanent knowledge-base ledger
# that enables drift detection.
# Run locally:  docker run -p 27017:27017 mongo:7
# Atlas (cloud): set host to your cluster hostname and provide credentials below.
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
# Authentication database. Use "$external" for LDAP / X.509 / AWS IAM auth.
# Leave empty to default to MONGODB_DB_NAME.
MONGODB_AUTH_SOURCE=
# Set to false to disable TLS (e.g. plain local dev instance).
MONGODB_TLS=true
# All collections are created inside this database automatically.
MONGODB_DB_NAME=knowledge_pipeline
# Optional prefix applied to every collection name (e.g. "prod_" or "dev_").
# Useful when sharing one MongoDB instance across environments.
MONGODB_COLLECTION_PREFIX=
